      <bpmn:incoming>Flow_BotErrorToManual</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualERPToMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VorgangPruefenManager" name="Vorgang prüfen (Manager)">
      <bpmn:extensionElements>
