<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Rechnungsfreigabe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="1d3193f" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_1" name="Rechnungsfreigabe_27.5">
    <bpmn:participant id="Participant_Eingangsrechnung" name="Eingangsrechnungsbearbeitung" processRef="Process_Rechnungsfreigabe" />
    <bpmn:textAnnotation id="TextAnnotation_gRPC">
      <bpmn:text>Retries: 3</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_RabbitMQ">
      <bpmn:text>Retries: 3</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_RabbitMQ" sourceRef="Task_ZahlungVeranlassen" targetRef="TextAnnotation_RabbitMQ" />
    <bpmn:association id="Association_gRPC" sourceRef="Task_MetadatenSpeichern" targetRef="TextAnnotation_gRPC" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Rechnungsfreigabe_UiPath" name="Rechnungsfreigabeprozess mit UiPath-Bot" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Rechnungsfreigabe">
      <bpmn:lane id="Lane_WorkflowEngine" name="System / Workflow-Engine">
        <bpmn:flowNodeRef>EndEvent_Abgelehnt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_AbbruchTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ComplianceAbgelehnt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RuckfrageWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Freigabeentscheidung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RueckfrageSenden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Portal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ComplianceBestanden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ComplianceErforderlich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Abgeschlossen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Archivieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeAfterPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZahlungVeranlassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeBeforeERP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeBeforeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeAfterGRPC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MetadatenSpeichern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeBeforegRPC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComplianceRules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PdfAuslesen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_AntwortErhalten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Zeitueberschritten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Error_RabbitMQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Error_gRPC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UiPathERPErfassung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeAfterERP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Error_UiPath</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sachbearbeiter" name="Sachbearbeiter">
        <bpmn:flowNodeRef>Task_ManuelleZahlung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ERPErfassung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComplianceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManuellSpeichern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MetadatenErfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RechnungPruefen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_TimerToAbbruch" sourceRef="Event_Zeitueberschritten" targetRef="EndEvent_AbbruchTimer" />
    <bpmn:sequenceFlow id="Flow_ToZeitueberschritten" sourceRef="Gateway_RuckfrageWait" targetRef="Event_Zeitueberschritten" />
    <bpmn:sequenceFlow id="Flow_ToAntwortErhalten" sourceRef="Gateway_RuckfrageWait" targetRef="Event_AntwortErhalten" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="Nein" sourceRef="Gateway_Freigabeentscheidung" targetRef="EndEvent_Abgelehnt" />
    <bpmn:sequenceFlow id="Flow_ToRuckfrageWait" sourceRef="Task_RueckfrageSenden" targetRef="Gateway_RuckfrageWait" />
    <bpmn:sequenceFlow id="Flow_InfoRequired" name="Rückfrage" sourceRef="Gateway_Freigabeentscheidung" targetRef="Task_RueckfrageSenden">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(approvalDecision = "INFO_REQUIRED")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approved" name="Ja" sourceRef="Gateway_Freigabeentscheidung" targetRef="Task_ComplianceRules">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(approvalDecision = "APPROVED")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AntwortToMerge" sourceRef="Event_AntwortErhalten" targetRef="Gateway_MergeBeforeReview" />
    <bpmn:sequenceFlow id="Flow_PaymentErrorToFallback" sourceRef="Boundary_Error_RabbitMQ" targetRef="Task_ManuelleZahlung" />
    <bpmn:sequenceFlow id="Flow_ComplianceFailed" name="Nein" sourceRef="Gateway_ComplianceBestanden" targetRef="EndEvent_ComplianceAbgelehnt" />
    <bpmn:sequenceFlow id="Flow_ComplianceRulesToGateway" sourceRef="Task_ComplianceRules" targetRef="Gateway_ComplianceErforderlich" />
    <bpmn:sequenceFlow id="Flow_ArchivToEnd" sourceRef="Task_Archivieren" targetRef="EndEvent_Abgeschlossen" />
    <bpmn:sequenceFlow id="Flow_PaymentToArchiv" sourceRef="Gateway_MergeAfterPayment" targetRef="Task_Archivieren" />
    <bpmn:sequenceFlow id="Flow_FallbackPaymentToMerge" sourceRef="Task_ManuelleZahlung" targetRef="Gateway_MergeAfterPayment" />
    <bpmn:sequenceFlow id="Flow_PaymentToMerge" sourceRef="Task_ZahlungVeranlassen" targetRef="Gateway_MergeAfterPayment" />
    <bpmn:sequenceFlow id="Flow_BotSuccessToMerge" sourceRef="Task_UiPathERPErfassung" targetRef="Gateway_MergeAfterERP" />
    <bpmn:sequenceFlow id="Flow_BotErrorToManual" sourceRef="Boundary_Error_UiPath" targetRef="Task_ERPErfassung" />
    <bpmn:sequenceFlow id="Flow_ManualERPToMerge" sourceRef="Task_ERPErfassung" targetRef="Gateway_MergeAfterERP" />
    <bpmn:sequenceFlow id="Flow_ERPToPayment" sourceRef="Gateway_MergeAfterERP" targetRef="Task_ZahlungVeranlassen" />
    <bpmn:sequenceFlow id="Flow_ERPStart" sourceRef="Gateway_MergeBeforeERP" targetRef="Task_UiPathERPErfassung" />
    <bpmn:sequenceFlow id="Flow_CompliancePassed" name="Ja" sourceRef="Gateway_ComplianceBestanden" targetRef="Gateway_MergeBeforeERP">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(complianceDecision = "PASSED")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ComplianceNo" name="Nein" sourceRef="Gateway_ComplianceErforderlich" targetRef="Gateway_MergeBeforeERP" />
    <bpmn:sequenceFlow id="Flow_ComplianceCheckToGateway" sourceRef="Task_ComplianceCheck" targetRef="Gateway_ComplianceBestanden" />
    <bpmn:sequenceFlow id="Flow_ComplianceYes" name="Ja" sourceRef="Gateway_ComplianceErforderlich" targetRef="Task_ComplianceCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(complianceRequired = true or dmnComplianceRequired = true)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReviewToGateway" sourceRef="Task_RechnungPruefen" targetRef="Gateway_Freigabeentscheidung" />
    <bpmn:sequenceFlow id="Flow_MergeToReviewTask" sourceRef="Gateway_MergeBeforeReview" targetRef="Task_RechnungPruefen" />
    <bpmn:sequenceFlow id="Flow_MergeToReview" sourceRef="Gateway_MergeAfterGRPC" targetRef="Gateway_MergeBeforeReview" />
    <bpmn:sequenceFlow id="Flow_FallbackToMerge" sourceRef="Task_ManuellSpeichern" targetRef="Gateway_MergeAfterGRPC" />
    <bpmn:sequenceFlow id="Flow_GRPCErrorToFallback" sourceRef="Boundary_Error_gRPC" targetRef="Task_ManuellSpeichern" />
    <bpmn:sequenceFlow id="Flow_GRPCToMerge" sourceRef="Task_MetadatenSpeichern" targetRef="Gateway_MergeAfterGRPC" />
    <bpmn:sequenceFlow id="Flow_EmailToPdf" sourceRef="StartEvent_Email" targetRef="Task_PdfAuslesen" />
    <bpmn:sequenceFlow id="Flow_PdfToMeta" sourceRef="Task_PdfAuslesen" targetRef="Task_MetadatenErfassen" />
    <bpmn:sequenceFlow id="Flow_ToGRPC" sourceRef="Gateway_MergeBeforegRPC" targetRef="Task_MetadatenSpeichern" />
    <bpmn:sequenceFlow id="Flow_MetaToMergegRPC" sourceRef="Task_MetadatenErfassen" targetRef="Gateway_MergeBeforegRPC" />
    <bpmn:sequenceFlow id="Flow_PortalToMergegRPC" sourceRef="StartEvent_Portal" targetRef="Gateway_MergeBeforegRPC" />
    <bpmn:boundaryEvent id="Boundary_Error_gRPC" name="gRPC Fehler" attachedToRef="Task_MetadatenSpeichern">
      <bpmn:outgoing>Flow_GRPCErrorToFallback</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_gRPC_ID" zeebe:errorMessageVariable="errorMessage" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Error_RabbitMQ" name="RabbitMQ Fehler" attachedToRef="Task_ZahlungVeranlassen">
      <bpmn:outgoing>Flow_PaymentErrorToFallback</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_RabbitMQ_ID" zeebe:errorMessageVariable="errorMessage" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Error_UiPath" name="UiPath Fehler" attachedToRef="Task_UiPathERPErfassung">
      <bpmn:outgoing>Flow_BotErrorToManual</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_UiPath_ID" zeebe:errorMessageVariable="errorMessage" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndEvent_Abgelehnt" name="Rechnung abgelehnt">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_AbbruchTimer" name="Abbruch (Zeitüberschreitung)">
      <bpmn:incoming>Flow_TimerToAbbruch</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ComplianceAbgelehnt" name="Abgelehnt (Compliance)">
      <bpmn:incoming>Flow_ComplianceFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:eventBasedGateway id="Gateway_RuckfrageWait" name="Warten auf Antwort / Timer">
      <bpmn:incoming>Flow_ToRuckfrageWait</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAntwortErhalten</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToZeitueberschritten</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:exclusiveGateway id="Gateway_Freigabeentscheidung" name="Freigabeentscheidung?" default="Flow_Rejected">
      <bpmn:incoming>Flow_ReviewToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_InfoRequired</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RueckfrageSenden" name="Rückfrage an Lieferanten senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-information-request" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InfoRequired</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRuckfrageWait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="StartEvent_Portal" name="Rechnungseingang (Portal)">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_PortalStart" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_PortalToMergegRPC</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ManuelleZahlung" name="Zahlung manuell erfassen">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_ManuelleZahlung" />
        <zeebe:assignmentDefinition candidateGroups="sachbearbeiter" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentErrorToFallback</bpmn:incoming>
      <bpmn:outgoing>Flow_FallbackPaymentToMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ERPErfassung" name="Rechnung im ERP erfassen">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_ERPBestaetigung" />
        <zeebe:assignmentDefinition candidateGroups="sachbearbeiter" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BotErrorToManual</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualERPToMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_UiPathERPErfassung" name="Rechnung im ERP per Bot erfassen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="uipath-erp-erfassung" retries="1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ERPStart</bpmn:incoming>
      <bpmn:outgoing>Flow_BotSuccessToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeAfterERP" name="Merge ERP Abschluss">
      <bpmn:incoming>Flow_BotSuccessToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ManualERPToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ERPToPayment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_ComplianceBestanden" name="Compliance bestanden?" default="Flow_ComplianceFailed">
      <bpmn:incoming>Flow_ComplianceCheckToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_CompliancePassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_ComplianceFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_ComplianceErforderlich" name="Compliance erforderlich?" default="Flow_ComplianceNo">
      <bpmn:incoming>Flow_ComplianceRulesToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ComplianceYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ComplianceNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Abgeschlossen" name="Rechnung abgeschlossen">
      <bpmn:incoming>Flow_ArchivToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Archivieren" name="Rechnung archivieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="archive-invoice" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentToArchiv</bpmn:incoming>
      <bpmn:outgoing>Flow_ArchivToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeAfterPayment" name="Merge Zahlung">
      <bpmn:incoming>Flow_PaymentToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_FallbackPaymentToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentToArchiv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ZahlungVeranlassen" name="Zahlungsauftrag per RabbitMQ senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-payment-order" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ERPToPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeBeforeERP" name="Merge ERP">
      <bpmn:incoming>Flow_ComplianceNo</bpmn:incoming>
      <bpmn:incoming>Flow_CompliancePassed</bpmn:incoming>
      <bpmn:outgoing>Flow_ERPStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ComplianceCheck" name="Compliance Check durchführen">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_ComplianceCheck" />
        <zeebe:assignmentDefinition candidateGroups="sachbearbeiter" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ComplianceYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ComplianceCheckToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeBeforeReview" name="Merge Review">
      <bpmn:incoming>Flow_MergeToReview</bpmn:incoming>
      <bpmn:incoming>Flow_AntwortToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToReviewTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_MergeAfterGRPC" name="Merge gRPC">
      <bpmn:incoming>Flow_GRPCToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_FallbackToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManuellSpeichern" name="Metadaten manuell speichern">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_ManuelleSpeicherung" />
        <zeebe:assignmentDefinition candidateGroups="sachbearbeiter" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GRPCErrorToFallback</bpmn:incoming>
      <bpmn:outgoing>Flow_FallbackToMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_MetadatenSpeichern" name="Metadaten per gRPC speichern">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="save-invoice-metadata" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToGRPC</bpmn:incoming>
      <bpmn:outgoing>Flow_GRPCToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_MetadatenErfassen" name="Rechnungsmetadaten erfassen">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_MetadatenErfassung" />
        <zeebe:assignmentDefinition candidateGroups="sachbearbeiter" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PdfToMeta</bpmn:incoming>
      <bpmn:outgoing>Flow_MetaToMergegRPC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_PdfAuslesen" name="Rechnungs-PDF auslesen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="extract-pdf-metadata" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EmailToPdf</bpmn:incoming>
      <bpmn:outgoing>Flow_PdfToMeta</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeBeforegRPC" name="Merge vor gRPC">
      <bpmn:incoming>Flow_PortalToMergegRPC</bpmn:incoming>
      <bpmn:incoming>Flow_MetaToMergegRPC</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGRPC</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_ComplianceRules" name="Compliance-Regeln auswerten">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Decision_ComplianceCheck" resultVariable="dmnComplianceRequired" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ComplianceRulesToGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:startEvent id="StartEvent_Email" name="Rechnungseingang (E-Mail)">
      <bpmn:outgoing>Flow_EmailToPdf</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Email" messageRef="Message_InvoiceReceived" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Event_AntwortErhalten" name="Antwort erhalten">
      <bpmn:incoming>Flow_ToAntwortErhalten</bpmn:incoming>
      <bpmn:outgoing>Flow_AntwortToMerge</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Antwort" messageRef="Message_Antwort" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_Zeitueberschritten" name="Wertezeit überschritten (14d)">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_ToZeitueberschritten</bpmn:incoming>
      <bpmn:outgoing>Flow_TimerToAbbruch</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_RechnungPruefen" name="Rechnung prüfen &#38; freigeben">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_RechnungsPruefung" />
        <zeebe:assignmentDefinition candidateGroups="pruefer" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeToReviewTask</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewToGateway</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmn:error id="Error_gRPC_ID" name="gRPC Error" errorCode="ERR_GRPC" />
  <bpmn:error id="Error_RabbitMQ_ID" name="RabbitMQ Error" errorCode="ERR_RABBITMQ" />
  <bpmn:error id="Error_UiPath_ID" name="UiPath Error" errorCode="ERR_UIPATH_FAILED" />
  <bpmn:message id="Message_InvoiceReceived" name="Message_InvoiceReceived_UiPath" />
  <bpmn:message id="Message_Antwort" name="Message_Antwort">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=invoiceId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Rechnungsfreigabe">
    <bpmndi:BPMNPlane id="BPMNPlane_Rechnungsfreigabe" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Eingangsrechnung_di" bpmnElement="Participant_Eingangsrechnung" isHorizontal="true">
