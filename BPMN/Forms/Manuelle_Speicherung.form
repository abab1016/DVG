{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.6.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "1d3193f"
  },
  "schemaVersion": 19,
  "id": "Form_ManuelleSpeicherung",
  "components": [
    {
      "text": "### gRPC-Service nicht erreichbar\nDie automatische Metadatenspeicherung ist fehlgeschlagen. Bitte bestätigen Sie, dass die Daten anderweitig gesichert wurden.",
      "type": "text",
      "id": "Field_Header"
    },
    {
      "text": "### Rechnungs-PDF\n[Rechnungs-PDF anzeigen / herunterladen ({{fileName}})](http://localhost:8090/api/files/{{fileName}})",
      "type": "text",
      "id": "Field_pdfLink"
    },
    {
      "text": "**Rechnungsdaten zur Prüfung:**",
      "type": "text",
      "id": "Field_SubHeader"
    },
    {
      "label": "Rechnungs-ID",
      "type": "textfield",
      "layout": {
        "row": "Row_1",
        "columns": 6
      },
      "id": "Field_invoiceId",
      "key": "invoiceId",
      "disabled": true
    },
    {
      "label": "Rechnungsnummer",
      "type": "textfield",
      "layout": {
        "row": "Row_1",
        "columns": 6
      },
      "id": "Field_invoiceNumber",
      "key": "invoiceNumber",
      "disabled": true
    },
    {
      "label": "Lieferantenname",
      "type": "textfield",
      "layout": {
        "row": "Row_2",
        "columns": 6
      },
      "id": "Field_supplierName",
      "key": "supplierName",
      "disabled": true
    },
    {
      "label": "Lieferanten-E-Mail",
      "type": "textfield",
      "layout": {
        "row": "Row_2",
        "columns": 6
      },
      "id": "Field_supplierEmail",
      "key": "supplierEmail",
      "disabled": true
    },
    {
      "label": "Rechnungsdatum",
      "type": "textfield",
      "layout": {
        "row": "Row_3",
        "columns": 6
      },
      "id": "Field_invoiceDate",
      "key": "invoiceDate",
      "disabled": true
    },
    {
      "label": "Fälligkeitsdatum",
      "type": "textfield",
      "layout": {
        "row": "Row_3",
        "columns": 6
      },
      "id": "Field_dueDate",
      "key": "dueDate",
      "disabled": true
    },
    {
      "label": "Nettobetrag",
      "type": "number",
      "layout": {
        "row": "Row_4",
        "columns": 4
      },
      "id": "Field_amountNet",
      "key": "amountNet",
      "disabled": true
    },
    {
      "label": "Bruttobetrag",
      "type": "number",
      "layout": {
        "row": "Row_4",
        "columns": 4
      },
      "id": "Field_amountGross",
      "key": "amountGross",
      "disabled": true
    },
    {
      "label": "Währung",
      "type": "textfield",
      "layout": {
        "row": "Row_4",
        "columns": 4
      },
      "id": "Field_currency",
      "key": "currency",
      "disabled": true
    },
    {
      "label": "IBAN",
      "type": "textfield",
      "layout": {
        "row": "Row_5"
      },
      "id": "Field_iban",
      "key": "iban",
      "disabled": true
    },
    {
      "label": "Dateiname",
      "type": "textfield",
      "layout": {
        "row": "Row_6",
        "columns": 6
      },
      "id": "Field_fileName",
      "key": "fileName",
      "disabled": true
    },
    {
      "label": "Eingangskanal",
      "type": "textfield",
      "layout": {
        "row": "Row_6",
        "columns": 6
      },
      "id": "Field_channel",
      "key": "channel",
      "disabled": true
    },
    {
      "label": "Rechnungsadresse",
      "type": "textfield",
      "layout": {
        "row": "Row_7"
      },
      "id": "Field_billingAddress",
      "key": "billingAddress",
      "disabled": true
    },
    {
      "label": "Rechnungspositionen",
      "type": "textarea",
      "layout": {
        "row": "Row_8"
      },
      "id": "Field_invoiceItems",
      "key": "invoiceItems",
      "disabled": true
    },
    {
      "label": "Fehlermeldung",
      "type": "textfield",
      "layout": {
        "row": "Row_Error"
      },
      "id": "Field_errorMessage",
      "key": "errorMessage",
      "disabled": true
    },
    {
      "label": "Daten manuell gesichert *",
      "type": "checkbox",
      "layout": {
        "row": "Row_Confirm"
      },
      "id": "Field_metadataStored",
      "key": "metadataStored",
      "validate": {
        "required": true
      },
      "description": "Bestätigen Sie, dass die Metadaten anderweitig gesichert wurden"
    },
    {
      "label": "Kommentar",
      "type": "textarea",
      "layout": {
        "row": "Row_Comment"
      },
      "id": "Field_manualStorageComment",
      "key": "manualStorageComment"
    }
  ],
  "type": "default"
}