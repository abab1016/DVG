      <bpmn:incoming>Flow_TimerToAbbruch</bpmn:incoming>
      <bpmn:incoming>Flow_1n40m7h</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToManager</bpmn:outgoing>
