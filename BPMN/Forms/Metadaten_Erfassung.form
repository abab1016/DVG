{
  "components": [
    {
      "text": "### Rechnungsmetadaten erfassen\nBitte alle Pflichtfelder (*) aus der Rechnung übertragen.",
      "type": "text",
      "id": "Field_Header"
    },
    {
      "text": "### ⚠️ AI-Extraktion unvollständig / unplausibel\n**Ursachen für Human Review:**\n{{aiReviewGruende}}",
      "type": "text",
      "id": "Field_aiReviewGruende",
      "conditional": {
        "hide": "=aiPlausibilityStatus != \"NEEDS_REVIEW\""
      }
    },
    {
      "text": "### Rechnungs-PDF\n[Rechnungs-PDF anzeigen / herunterladen ({{fileName}})](http://localhost:8090/api/files/{{fileName}})",
      "type": "text",
      "id": "Field_pdfLink"
    },
    {
      "label": "Rechnungs-ID *",
      "type": "textfield",
      "layout": {
        "row": "Row_1",
        "columns": 6
      },
      "id": "Field_invoiceId",
      "key": "invoiceId",
      "validate": {
        "required": true
      },
      "disabled": false
    },
    {
      "label": "Rechnungsnummer *",
      "type": "textfield",
      "layout": {
        "row": "Row_1",
        "columns": 6
      },
      "id": "Field_invoiceNumber",
      "key": "invoiceNumber",
      "validate": {
        "required": true
      },
      "description": "z.B. RE-2026-7781"
    },
    {
      "label": "Lieferantenname *",
      "type": "textfield",
      "layout": {
        "row": "Row_2",
        "columns": 6
      },
      "id": "Field_supplierName",
      "key": "supplierName",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Lieferanten-E-Mail",
      "type": "textfield",
      "layout": {
        "row": "Row_2",
        "columns": 6
      },
      "id": "Field_supplierEmail",
      "key": "supplierEmail"
    },
    {
      "label": "Rechnungsdatum *",
      "type": "textfield",
      "layout": {
        "row": "Row_3",
        "columns": 6
      },
      "id": "Field_invoiceDate",
      "key": "invoiceDate",
      "description": "JJJJ-MM-TT",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Fälligkeitsdatum",
      "type": "textfield",
      "layout": {
        "row": "Row_3",
        "columns": 6
      },
      "id": "Field_dueDate",
      "key": "dueDate",
      "description": "JJJJ-MM-TT"
    },
    {
      "label": "Nettobetrag",
      "type": "number",
      "layout": {
        "row": "Row_4",
        "columns": 4
      },
      "id": "Field_amountNet",
      "key": "amountNet"
    },
    {
      "label": "Bruttobetrag *",
      "type": "number",
      "layout": {
        "row": "Row_4",
        "columns": 4
      },
      "id": "Field_amountGross",
      "key": "amountGross",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Währung *",
      "type": "textfield",
      "layout": {
        "row": "Row_4",
        "columns": 4
      },
      "id": "Field_currency",
      "key": "currency",
      "defaultValue": "EUR",
      "validate": {
        "required": true
      }
    },
    {
      "label": "IBAN *",
      "type": "textfield",
      "layout": {
        "row": "Row_5"
      },
      "id": "Field_iban",
      "key": "iban",
      "validate": {
        "required": true
      },
      "description": "Zahlungsempfänger-IBAN"
    },
    {
      "label": "Rechnungs-PDF hochladen (optional)",
      "type": "filepicker",
      "layout": {
        "row": "Row_PdfUpload"
      },
      "id": "Field_pdfUpload",
      "key": "pdfUpload",
      "description": "PDF der Eingangsrechnung hochladen – wird automatisch im System gespeichert"
    },
    {
      "label": "Dateiname",
      "type": "textfield",
      "layout": {
        "row": "Row_6",
        "columns": 6
      },
      "id": "Field_fileName",
      "key": "fileName",
      "description": "Wird automatisch aus dem Upload befüllt, oder manuell eintragen"
    },
    {
      "label": "Eingangskanal *",
      "type": "select",
      "layout": {
        "row": "Row_6",
        "columns": 6
      },
      "id": "Field_channel",
      "key": "channel",
      "defaultValue": "EMAIL",
      "validate": {
        "required": true
      },
      "valuesExpression": "=[{\"label\": \"E-Mail\", \"value\": \"EMAIL\"}, {\"label\": \"EDI\", \"value\": \"EDI\"}]"
    },
    {
      "label": "Rechnungsadresse *",
      "type": "textfield",
      "layout": {
        "row": "Row_7"
      },
      "id": "Field_billingAddress",
      "key": "billingAddress",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Rechnungspositionen",
      "components": [
        {
          "label": "Beschreibung",
          "type": "textfield",
          "layout": {
            "row": "Row_Item_1",
            "columns": 6
          },
          "id": "Field_Item_Description",
          "key": "description",
          "validate": {
            "required": true
          }
        },
        {
          "label": "Menge",
          "type": "number",
          "layout": {
            "row": "Row_Item_1",
            "columns": 2
          },
          "id": "Field_Item_Quantity",
          "key": "quantity",
          "validate": {
            "required": true
          }
        },
        {
          "label": "Einzelpreis",
          "type": "number",
          "layout": {
            "row": "Row_Item_1",
            "columns": 2
          },
          "id": "Field_Item_UnitPrice",
          "key": "unitPrice"
        },
        {
          "label": "Gesamtpreis",
          "type": "number",
          "layout": {
            "row": "Row_Item_1",
            "columns": 2
          },
          "id": "Field_Item_TotalPrice",
          "key": "totalPrice"
        }
      ],
      "showOutline": true,
      "isRepeating": true,
      "allowAddRemove": true,
      "defaultRepetitions": 1,
      "type": "dynamiclist",
      "layout": {
        "row": "Row_8"
      },
      "id": "Field_invoiceItems",
      "isReorderable": true,
      "allowAdd": true,
      "allowRemove": true,
      "path": "invoiceItems"
    },
    {
      "text": "⚠️ **Keine Rechnungspositionen vorhanden. Bitte mindestens eine Position erfassen.**",
      "type": "text",
      "id": "Field_ItemsEmptyHint",
      "layout": {
        "row": "Row_ItemsEmpty"
      },
      "conditional": {
        "hide": "=invoiceItems != null and count(invoiceItems) > 0"
      }
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.6.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.48.0"
  },
  "schemaVersion": 19,
  "id": "Form_MetadatenErfassung",
  "type": "default"
}