    <bpmn:sequenceFlow id="Flow_12_Nein" name="Nein" sourceRef="Gateway_ComplianceBestanden" targetRef="EndEvent_ComplianceAbgelehnt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=compliancePassed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12_Ja" name="Ja" sourceRef="Gateway_ComplianceBestanden" targetRef="Gateway_MergeFreigabe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=compliancePassed = true</bpmn:conditionExpression>
