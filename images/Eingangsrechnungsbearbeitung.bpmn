    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ManuelleFreigabe" targetRef="Gateway_Freigegeben" />
    <bpmn:sequenceFlow id="Flow_15_Ja" name="Ja" sourceRef="Gateway_Freigegeben" targetRef="Gateway_MergeERP">
