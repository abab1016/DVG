        <zeebe:assignmentDefinition candidateGroups="manager" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeToManager</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_VorgangAbgeschlossenManager" name="Vorgang durch Manager abgeschlossen">
      <bpmn:incoming>Flow_ManagerToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1n40m7h" sourceRef="Gateway_MergeBeforegRPC" targetRef="Gateway_MergeBeforeManager" />
