{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.6.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "1d3193f"
  },
  "schemaVersion": 19,
  "id": "Form_Rueckfrage",
  "components": [
    {
      "text": "### Informationen nachfordern\nDer Prüfer hat zusätzliche Informationen angefordert.",
      "type": "text",
      "id": "Field_Header"
    },
    {
      "text": "### Rechnungs-PDF\n[Rechnungs-PDF anzeigen / herunterladen ({{fileName}})](http://localhost:8090/api/files/{{fileName}})",
      "type": "text",
      "id": "Field_pdfLink"
    },
    {
      "text": "**Rechnungsdaten zur Prüfung:**",
      "type": "text",
      "id": "Field_SubHeader"
    },
    {
      "label": "Rechnungs-ID",
      "type": "textfield",
      "layout": {
        "row": "Row_1",
        "columns": 6
      },
      "id": "Field_invoiceId",
      "key": "invoiceId",
      "disabled": true
    },
    {
      "label": "Rechnungsnummer",
      "type": "textfield",
      "layout": {
        "row": "Row_1",
        "columns": 6
      },
      "id": "Field_invoiceNumber",
      "key": "invoiceNumber",
      "disabled": true
    },
    {
      "label": "Lieferantenname",
      "type": "textfield",
      "layout": {
        "row": "Row_2",
        "columns": 6
      },
      "id": "Field_supplierName",
      "key": "supplierName",
      "disabled": true
    },
    {
      "label": "Lieferanten-E-Mail",
      "type": "textfield",
      "layout": {
        "row": "Row_2",
        "columns": 6
      },
      "id": "Field_supplierEmail",
      "key": "supplierEmail",
      "disabled": true
    },
    {
      "label": "Rechnungsdatum",
      "type": "textfield",
      "layout": {
        "row": "Row_3",
        "columns": 6
      },
      "id": "Field_invoiceDate",
      "key": "invoiceDate",
      "disabled": true
    },
    {
      "label": "Fälligkeitsdatum",
      "type": "textfield",
      "layout": {
        "row": "Row_3",
        "columns": 6
      },
      "id": "Field_dueDate",
      "key": "dueDate",
      "disabled": true
    },
    {
      "label": "Nettobetrag",
      "type": "number",
      "layout": {
        "row": "Row_4",
        "columns": 4
      },
      "id": "Field_amountNet",
      "key": "amountNet",
      "disabled": true
    },
    {
      "label": "Bruttobetrag",
      "type": "number",
      "layout": {
        "row": "Row_4",
        "columns": 4
      },
      "id": "Field_amountGross",
      "key": "amountGross",
      "disabled": true
    },
    {
      "label": "Währung",
      "type": "textfield",
      "layout": {
        "row": "Row_4",
        "columns": 4
      },
      "id": "Field_currency",
      "key": "currency",
      "disabled": true
    },
    {
      "label": "IBAN",
      "type": "textfield",
      "layout": {
        "row": "Row_5"
      },
      "id": "Field_iban",
      "key": "iban",
      "disabled": true
    },
    {
      "label": "Dateiname",
      "type": "textfield",
      "layout": {
        "row": "Row_6",
        "columns": 6
      },
      "id": "Field_fileName",
      "key": "fileName",
      "disabled": true
    },
    {
      "label": "Eingangskanal",
      "type": "textfield",
      "layout": {
        "row": "Row_6",
        "columns": 6
      },
      "id": "Field_channel",
      "key": "channel",
      "disabled": true
    },
    {
      "label": "Rechnungsadresse",
      "type": "textfield",
      "layout": {
        "row": "Row_7"
      },
      "id": "Field_billingAddress",
      "key": "billingAddress",
      "disabled": true
    },
    {
      "label": "Rechnungspositionen",
      "type": "dynamiclist",
      "layout": {
        "row": "Row_8"
      },
      "id": "Field_invoiceItems",
      "isReorderable": false,
      "allowAdd": false,
      "allowRemove": false,
      "components": [
        {
          "label": "Beschreibung",
          "type": "textfield",
          "layout": {
            "row": "Row_Item_1",
            "columns": 6
          },
          "id": "Field_Item_Description",
          "key": "description",
          "validate": {
            "required": true
          },
          "disabled": true
        },
        {
          "label": "Menge",
          "type": "number",
          "layout": {
            "row": "Row_Item_1",
            "columns": 2
          },
          "id": "Field_Item_Quantity",
          "key": "quantity",
          "validate": {
            "required": true
          },
          "disabled": true
        },
        {
          "label": "Einzelpreis",
          "type": "number",
          "layout": {
            "row": "Row_Item_1",
            "columns": 2
          },
          "id": "Field_Item_UnitPrice",
          "key": "unitPrice",
          "disabled": true
        },
        {
          "label": "Gesamtpreis",
          "type": "number",
          "layout": {
            "row": "Row_Item_1",
            "columns": 2
          },
          "id": "Field_Item_TotalPrice",
          "key": "totalPrice",
          "disabled": true
        }
      ],
      "path": "invoiceItems"
    },
    {
      "label": "Kommentar des Prüfers",
      "type": "textarea",
      "layout": {
        "row": "Row_Comment_Pruefer"
      },
      "id": "Field_approvalComment",
      "key": "approvalComment",
      "disabled": true,
      "description": "Begründung für die Rückfrage"
    },
    {
      "label": "Antwort / Ergänzung *",
      "type": "textarea",
      "layout": {
        "row": "Row_Response"
      },
      "id": "Field_infoResponseComment",
      "key": "infoResponseComment",
      "validate": {
        "required": true
      },
      "description": "Bitte die fehlenden Informationen hier ergänzen"
    }
  ],
  "type": "default"
}